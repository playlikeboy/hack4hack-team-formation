{"dependencies":{"@hono/node-server":"^1.13.0","hono":"^4.6.0","pg":"^8.13.0","ws":"^8.18.0","zod":"^3.23.0"},"description":"Hack4Hack PS1 backend: Hono API + WebSockets + Postgres. Race-proof team formation.","devDependencies":{"@types/node":"^22.0.0","@types/pg":"^8.11.0","@types/ws":"^8.5.0","tsx":"^4.19.0","typescript":"~5.8.0","vitest":"^2.1.0"},"main":"dist/index.js","name":"hack4hack-server","private":true,"scripts":{"build":"tsc && cp src/db/schema.sql dist/db/schema.sql","dev":"tsx watch src/index.ts","seed":"tsx scripts/seed.ts","start":"node dist/index.js","test":"vitest run --passWithNoTests","typecheck":"tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json"},"version":"0.1.0"}