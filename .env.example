# Copy to .env for local development. PLACEHOLDER values only — never put
# real credentials in this file, and never commit .env.
#
# Local Postgres uses trust auth on localhost (no password). The user in
# DATABASE_URL must be a Postgres role that exists on your machine;
# `postgres` is the default superuser on most installs.

DATABASE_URL=postgres://postgres@localhost:5432/hack4hack
PORT=3000
NODE_ENV=development
SESSION_COOKIE_SECURE=false
PUBLIC_URL=http://localhost:3000

# Demo seed password (optional). If unset, `npm run seed -- --demo`
# generates a random password and prints it.
DEMO_PASSWORD=
